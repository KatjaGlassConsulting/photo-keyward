# Copy this file to .env and adjust the values. .env is git-ignored, so it
# holds machine-specific paths and never leaves your checkout.

# Full path to the exiftool executable.
#
# Leave this unset (or delete the line) if `exiftool` is already on your PATH —
# that is the normal case on macOS and Linux, and on Windows if you installed
# exiftool to a folder on PATH. Set it when exiftool lives somewhere the shell
# cannot find, for example a portable unzipped copy.
#
# A path that does not exist is ignored, and the app falls back to PATH.
# ~ and $VARS / %VARS% are expanded. Do not quote the value.
#
# Windows: EXIFTOOL_PATH=C:\tools\exiftool-13.58_64\exiftool.exe
# macOS:   EXIFTOOL_PATH=/opt/homebrew/bin/exiftool
# Linux:   EXIFTOOL_PATH=/usr/bin/exiftool
EXIFTOOL_PATH=
