# Normalize to LF in the repository, whatever the working tree uses. Without
# this, an editor or script on Windows can silently rewrite a whole file as
# CRLF and bury a one-line change in a several-hundred-line diff.
* text=auto eol=lf

# Generated by uv; keep it out of diffs and merge conflicts.
uv.lock linguist-generated=true merge=binary
